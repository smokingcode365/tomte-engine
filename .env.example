POSTGRES_DB=tomte
POSTGRES_USER=tomte
POSTGRES_PASSWORD=replace_with_local_password

# Replace the URL password with the percent-encoded form of POSTGRES_PASSWORD.
# For example, an @ character becomes %40. Never reuse these placeholders.
POSTGRES_URL=postgresql://tomte:URL_ENCODED_LOCAL_PASSWORD@127.0.0.1:5432/tomte
REDIS_URL=redis://127.0.0.1:6379/0
# Candidate filtering has its own model; dictionary alignment still uses cheap_model.
OPENAI__CANDIDATE_FILTER_MODEL=gpt-6.1-terra
# LLM-assisted retrieval reads fact candidates in batches of 20, up to 100.
OPENAI__ANSWER_READER_MODEL=gpt-6.1-terra
# Legacy catalogue selector; not called by retrieval or answering.
OPENAI__RETRIEVAL_PLANNER_MODEL=gpt-6.1-terra
ANSWER_RETRIEVAL__FACT_LIMIT=100
# Stop only when every score in the last 10 is strictly below 30.
ANSWER_RETRIEVAL__RELEVANCE_TAIL_SIZE=10
ANSWER_RETRIEVAL__RELEVANCE_STOP_THRESHOLD=30
# Maximum individual fact packet size in UTF-8 bytes; values are never truncated.
ANSWER_RETRIEVAL__LANE_BYTES=24000
# Both query and stored vectors must use this same model and dimension.
# Changing models requires re-embedding existing memory and dictionary vectors.
OPENAI__EMBED_MODEL=openai:text-embedding-3-large
OPENAI__VECTOR_DIMENSION=1536
# Optional stored-memory retrieval. Backfill each user's lexical index before opting in.
# See docs/bm25-retrieval.md. Default vector preserves the two-list cosine retrieval.
STORED_RETRIEVAL_MODE=vector
