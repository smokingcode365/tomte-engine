POSTGRES_DB=tomte
POSTGRES_USER=tomte
POSTGRES_PASSWORD=replace_with_local_password

# Replace the URL password with the percent-encoded form of POSTGRES_PASSWORD.
# For example, an @ character becomes %40. Never reuse these placeholders.
POSTGRES_URL=postgresql://tomte:URL_ENCODED_LOCAL_PASSWORD@127.0.0.1:5432/tomte
REDIS_URL=redis://127.0.0.1:6379/0
OPENAI__VECTOR_DIMENSION=1536
